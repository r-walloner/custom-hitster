# Copy to .env and fill in. Read by the backend and by docker compose.

# From the Spotify app at https://developer.spotify.com/dashboard
JAMSTER_SPOTIFY_CLIENT_ID=
JAMSTER_SPOTIFY_CLIENT_SECRET=

# Signs the session cookie. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JAMSTER_SESSION_SECRET=

# Public address of the deployed site, e.g. https://jamster.example.com
# Leave empty on your own machine.
JAMSTER_BASE_URL=

# A URL or email address MusicBrainz can reach you at. Its API rules ask for one.
JAMSTER_MUSICBRAINZ_CONTACT=

# Logging; uncomment to change. An empty value counts as unset.
# Level: INFO (the default; each game move by move), DEBUG (adds every Spotify and
# MusicBrainz call), WARNING or ERROR.
# JAMSTER_LOG_LEVEL=INFO
# Where to: "file" (the default when run with fastapi dev) or "stdout" (the container's default).
# JAMSTER_LOG_TO=file
# The file, by default jamster.log in the data directory (backend/data/ locally).
# JAMSTER_LOG_FILE=
