{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: launch (dev)",
      "type": "shell",
      "command": "uv run fastapi dev",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Frontend: launch (dev)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Launch all (dev)",
      "dependsOn": ["Backend: launch (dev)", "Frontend: launch (dev)"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Deploy: erdkern",
      "detail": "Build and push both images, then have the server pull and restart them",
      "type": "shell",
      "command": "docker compose -f compose.yaml -f compose.registry.production.yaml build --push && ssh -t core@erdkern.walloner.net 'sudo cpodman auto-update --authfile /var/mnt/data/registry-auth/containers-auth.json'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      }
    }
  ]
}
